# Variables d'environnement d'exemple

# Symfony
APP_ENV=dev
APP_SECRET=change_me_32_char_random_string

# Caddy / Mercure
CADDY_MERCURE_JWT_SECRET=change_me_mercure_jwt_secret
SERVER_NAME=":80"

# Base de données
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_DB=app
POSTGRES_VERSION=16
POSTGRES_CHARSET=utf8
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&${POSTGRES_CHARSET}"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=ChangeMe123!

# Stripe
STRIPE_API_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lexik JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe123!

# Mailer
MAILER_DSN="smtp://mailtrap_username:mailtrap_password@sandbox.smtp.mailtrap.io:2525"
